# Kiosk configuration. Copy to .env and fill in, then run:
#
#     uv run --env-file .env python main.py
#
# `uv run` does not read .env on its own, so the --env-file flag is needed.
# .env itself is gitignored (see the root .gitignore).

# Backend API base URL.
KIOSK_API_URL=http://localhost:8080/api/v1

# Seller-scoped API key, created in the web UI under /api-keys. Both the
# scan lookup and the sale are guarded, so without it the app boots but
# every scan fails with the backend's auth error.
KIOSK_API_KEY=

# Set to 1 to run fullscreen (on the Pi). Leave empty for the 1024x600
# development window.
KIOSK_FULLSCREEN=
