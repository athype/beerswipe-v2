{
  "name": "@beerswipe/backend",
  "type": "module",
  "version": "2.0.0",
  "description": "A beer system backend",
  "author": "Krisztian Kozari",
  "license": "Proprietary",
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [],
  "main": "src/index.ts",
  "scripts": {
    "start": "node src/index.ts",
    "start:local": "node --env-file=../.env src/index.ts",
    "dev": "node --watch --env-file=../.env src/index.ts",
    "lint": "eslint --fix src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "node --env-file=../.env scripts/seed.ts"
  },
  "dependencies": {
    "@beerswipe/types": "workspace:*",
    "@simplewebauthn/server": "^13.3.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.16.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.18.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint-plugin-format": "^1.0.1",
    "supertest": "^7.1.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
